{
    "name": "Facomerc Shorts Optimizer (Gemini Engine)",
    "nodes": [
        {
            "parameters": {
                "httpMethod": "POST",
                "path": "shorts-optimizer",
                "responseMode": "lastNode",
                "options": {}
            },
            "type": "n8n-nodes-base.webhook",
            "typeVersion": 1,
            "position": [
                250,
                300
            ],
            "id": "webhook-trigger",
            "name": "Webhook (Receive Clip Data)"
        },
        {
            "parameters": {
                "assignments": {
                    "assignments": [
                        {
                            "id": "prompt-assignment",
                            "name": "prompt",
                            "value": "Optimize this clip for virality. Context: {{ $json.body.clipTitle }} - {{ $json.body.clipReason }}",
                            "type": "string"
                        }
                    ]
                },
                "options": {}
            },
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                450,
                300
            ],
            "id": "format-prompt",
            "name": "Format Input"
        },
        {
            "parameters": {
                "model": "gemini-1.5-pro",
                "prompt": "={{ $json.prompt }}",
                "options": {}
            },
            "type": "n8n-nodes-base.googleGemini",
            "typeVersion": 1,
            "position": [
                650,
                300
            ],
            "id": "gemini-optimizer",
            "name": "Gemini 1.5 Pro (SEO Magic)",
            "credentials": {
                "googleGeminiApi": {
                    "id": "YOUR_CREDENTIAL_ID",
                    "name": "Google Gemini account"
                }
            }
        },
        {
            "parameters": {
                "options": {}
            },
            "type": "n8n-nodes-base.respondToWebhook",
            "typeVersion": 1,
            "position": [
                850,
                300
            ],
            "id": "return-optimized-data",
            "name": "Return Metadata"
        }
    ],
    "connections": {
        "Webhook (Receive Clip Data)": {
            "main": [
                [
                    {
                        "node": "Format Input",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format Input": {
            "main": [
                [
                    {
                        "node": "Gemini 1.5 Pro (SEO Magic)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gemini 1.5 Pro (SEO Magic)": {
            "main": [
                [
                    {
                        "node": "Return Metadata",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        }
    }
}